#!/bin/sh
# Dispatch to one backend inside the all-in-one image (see /Dockerfile):
#   pafpose-backend <backend> [adapter arguments...]
# Each backend runs with its own virtualenv interpreter; the adapters change directory
# themselves where the upstream code needs relative asset paths.
set -eu
BACKENDS="sam3dbody pear wilor teaser mediapipe"
usage() {
    echo "usage: pafpose-backend <backend> [adapter arguments...]" >&2
    echo "backends: ${BACKENDS}" >&2
    echo "example:  pafpose-backend pear --video /input/clip.mp4 --out /output --weights /weights/pear" >&2
}
backend="${1:-}"
case "${backend}" in
    ""|-h|--help|help|list) usage; exit 0 ;;
esac
shift
for known in ${BACKENDS}; do
    if [ "${known}" = "${backend}" ]; then
        exec "/opt/venvs/${backend}/bin/python" "/app/${backend}/adapter.py" "$@"
    fi
done
echo "pafpose-backend: unknown backend '${backend}'" >&2
usage
exit 2
